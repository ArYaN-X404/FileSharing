# ==============================================================
# Telegram File-Sharing & Streaming Bot - Environment Variables
# Copy this file to .env and configure for your deployment
# ==============================================================

# --------------------------------------------------------------
# 1. Mandatory Telegram Bot Credentials
# --------------------------------------------------------------
# Telegram Bot Token from @BotFather
TG_BOT_TOKEN=your_bot_token_here

# Telegram API credentials from https://my.telegram.org
APP_ID=12345678
API_HASH=your_api_hash_here

# Private Telegram Channel ID where videos/files are stored (starts with -100)
CHANNEL_ID=-1001234567890

# --------------------------------------------------------------
# 2. Security & Web Signing
# --------------------------------------------------------------
# Secret key used to sign and verify HMAC lecture tokens from the web UI
HMAC_TOKEN_SECRET=your_hmac_secret_key_here

# --------------------------------------------------------------
# 3. Bot Administration & Access Control
# --------------------------------------------------------------
# Telegram User ID of the primary bot owner
OWNER_ID=7507697121

# Space-separated list of additional Admin User IDs (optional)
ADMINS=7507697121 2131377350

# Force Subscribe Channel ID or Username (optional, e.g. -1001234567890 or mychannel)
# Leave blank to disable forced subscription
FORCE_SUB_CHANNEL=

# Prevent users from saving/forwarding media (True/False)
PROTECT_CONTENT=True

# --------------------------------------------------------------
# 4. Database & Persistence Configuration
# --------------------------------------------------------------
# Database Connection URL:
# - SQLite (Default): sqlite:///cds.db
# - PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///cds.db

# Direct PostgreSQL URL fallback (optional, overrides DATABASE_URL if set)
# POSTGRES_URL=

# Supabase Cloud Integration (optional)
USE_SUPABASE=false
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# --------------------------------------------------------------
# 5. Network, Concurrency & Cloud Hosting Settings
# --------------------------------------------------------------
# Port for the built-in aiohttp health check & auth web server (default: 8080)
PORT=8080

# Number of asynchronous Pyrogram worker tasks (default: 4)
TG_BOT_WORKERS=4

# --------------------------------------------------------------
# 6. Bot Behavior & Customization (Optional)
# --------------------------------------------------------------
# Auto-delete time in seconds (0 = disabled)
AUTO_DELETE_TIME=0
AUTO_DEL_SUCCESS_MSG=File will be deleted soon

# Disable the inline share button on channel posts (True/False)
DISABLE_CHANNEL_BUTTON=False

# Image URL displayed on /start command (leave blank for text-only)
START_PIC=

# Custom welcome message on /start (supports {first}, {last}, {username}, {mention}, {id})
START_MESSAGE=<b>Welcome {first},</b>\n\n<blockquote><b>EduVault Delivery Engine</b>\nYour secure gateway to high-performance video streaming.</blockquote>\n\nTo access your lectures, select a topic from the dashboard.

# Text displayed on /stats command (supports {uptime})
BOT_STATS_TEXT=<b>BOT UPTIME</b>\n{uptime}

# Auto-reply when a user sends regular text messages without commands
USER_REPLY_TEXT=Don't send me messages directly!

# --------------------------------------------------------------
# 7. Razorpay Payment Gateway (Optional)
# --------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
