# ==============================================================
# CDS File-Sharing & Streaming Bot - Example Environment
# Copy this file to .env and fill in your values
# ==============================================================

# Telegram Bot Credentials (from @BotFather and my.telegram.org)
TG_BOT_TOKEN=your_bot_token_here
APP_ID=your_app_id_here
API_HASH=your_api_hash_here

# Private Video Storage Channel ID (must start with -100...)
CHANNEL_ID=-100xxxxxxxxxx

# Security: Secret Key used to sign HMAC tokens from the web app
HMAC_TOKEN_SECRET=your_hmac_secret_here

# Admin & Owner IDs (Telegram User IDs separated by spaces)
OWNER_ID=123456789
ADMINS=123456789 987654321

# Database Configuration (SQLite default, or postgresql://user:pass@host/db)
DATABASE_URL=sqlite:///cds.db

# Delivery Protection (True = Disables saving & forwarding)
PROTECT_CONTENT=True

# Optional Web Health Port (For cloud hosting platforms)
PORT=8085
TG_BOT_WORKERS=4
